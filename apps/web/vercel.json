{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm vercel-build",
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": "/api/server" },
    { "source": "/api/docs", "destination": "/api/server" },
    { "source": "/api/docs/(.*)", "destination": "/api/server" }
  ],
  "functions": {
    "api/server.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "../../apps/api/dist/**,../../apps/api/prisma/**"
    }
  }
}
