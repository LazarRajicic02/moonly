# Environment Configuration
# Copy to .env and adjust for local development

# --- Shared ---
NODE_ENV=development

# --- Database ---
POSTGRES_USER=luna
POSTGRES_PASSWORD=luna_dev_password
POSTGRES_DB=luna
# Host port 5433 avoids clashes with other local Postgres instances (container still uses 5432)
DATABASE_URL=postgresql://luna:luna_dev_password@localhost:5433/luna?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API (apps/api) ---
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
THROTTLE_TTL=60
THROTTLE_LIMIT=100
CORS_ORIGINS=http://localhost:3000

# Email (Resend) — optional in dev
RESEND_API_KEY=
RESEND_FROM="Luna <noreply@luna.health>"

# AI (OpenAI-compatible) — optional in dev
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Firebase Cloud Messaging — optional in dev
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe — placeholder
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=

# Sentry — optional
SENTRY_DSN=
SENTRY_ENV=development

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
